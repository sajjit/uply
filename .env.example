# Points local dev (and Vercel Preview deployments) at a staging Supabase
# project instead of production. Copy this file to .env.local and fill in
# the staging project's values from Supabase Dashboard > Settings > API.
# Leave unset (or don't create .env.local) to fall back to production.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
